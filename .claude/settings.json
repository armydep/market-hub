{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(./mvnw:*)",
      "Bash(mvn:*)",
      "Bash(npm:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git push)",
      "Bash(git push origin:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.jks)",
      "Read(./**/*.p12)",
      "Edit(./.claude/settings.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(mvn deploy:*)",
      "Bash(mvn release:*)"
    ]
  },
  "env": {
    "MAVEN_OPTS": "-Xmx1g",
    "TESTCONTAINERS_RYUK_DISABLED": "true"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd backend && ./mvnw -q -B dependency:go-offline"
          }
        ]
      }
    ]
  }
}