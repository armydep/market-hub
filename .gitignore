# Maven build output
target/

# Node / frontend build output (frontend/.gitignore covers the module itself;
# these guard against stray installs elsewhere in the tree)
node_modules/
dist/
coverage/
*.tsbuildinfo

# Java and JVM artifacts
*.class
*.log
hs_err_pid*
replay_pid*

# IDE metadata
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# Operating-system files
.DS_Store
Thumbs.db

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Temporary files
*.swp
*.swo
*~
