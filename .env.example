# market-hub backend — local environment.
# Copy to .env and adjust as needed:   cp .env.example .env
# Load before running the app:          set -a && source .env && set +a
#
# Every value below already has a default in application.yml that matches
# docker-compose.yml, so `docker compose up -d && mvn spring-boot:run` works
# with NO .env at all for S0. Override only when you diverge from the defaults.

# --- S0: database (defaults match docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/markethub
DB_USERNAME=markethub
DB_PASSWORD=markethub

# --- S0: HTTP server ---
SERVER_PORT=8080

# --- S1: market ingestion (CoinMarketCap) ---
# Without a key the app still boots and serves an EMPTY universe (degrades, no crash).
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_CONVERT=USD
# Poller knobs (single-instance @Scheduled):
POLLER_ENABLED=true
POLLER_COIN_LIMIT=100
POLLER_INTERVAL_MS=180000
POLLER_INITIAL_DELAY_MS=5000

# Later slices append their own vars here (kept in sync per slice):
#   S2 (auth + RBAC): APP_JWT_SECRET, ADMIN_EMAIL, ADMIN_PASSWORD
