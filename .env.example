# market-hub backend — local environment.
# Copy to .env and adjust as needed:   cp .env.example .env
# Load before running the app:          set -a && source .env && set +a
#
# Every value below already has a default in application.yml that matches
# docker-compose.yml, so `docker compose up -d && mvn spring-boot:run` works
# with NO .env at all for S0. Override only when you diverge from the defaults.

# --- S0: database (defaults match docker-compose.yml) ---
DB_NAME=markethub
DB_URL=jdbc:postgresql://localhost:5432/markethub
DB_USERNAME=markethub
DB_PASSWORD=markethub

# --- S0: HTTP server ---
SERVER_PORT=8080
APP_LOG_LEVEL=INFO

# --- S1: market ingestion (CoinMarketCap) ---
# Without a key the app still boots and serves an EMPTY universe (degrades, no crash).
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_CONVERT=USD
# Poller knobs (single-instance @Scheduled):
POLLER_ENABLED=true
POLLER_COIN_LIMIT=100
POLLER_INTERVAL_MS=180000
POLLER_INITIAL_DELAY_MS=5000

# --- S2: public market dashboard presentation (PRD 7.3 requires these to be config) ---
# Validated at startup: every default-visible column must exist in the CoinColumn
# catalog, and the default page size must be one of the supported sizes.
MARKET_DEFAULT_PAGE_SIZE=20
MARKET_SUPPORTED_PAGE_SIZES=20,50,100
MARKET_DEFAULT_VISIBLE_COLUMNS=marketCapRank,name,symbol,price,pctChange1h,pctChange24h,pctChange7d,marketCap,volume24h,circulatingSupply

# --- S5: auth + RBAC ---
# Dev-only fallback in application.yml if unset; always set a real secret outside dev.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
# Empty by default: the startup seed skips gracefully with no admin configured.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- S6: sign-in protection ---
# Consecutive failed attempts before a temporary lockout (default 5).
AUTH_MAX_FAILED_ATTEMPTS=
# Lockout duration in minutes (default 15).
AUTH_LOCKOUT_DURATION_MINUTES=
